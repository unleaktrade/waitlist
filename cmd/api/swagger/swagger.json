{
  "openapi": "3.0.3",
  "info": {
    "title": "UnleakTrade Waitlist Rest-API",
    "version": "2.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "UNLK-API-KEY"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "address": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "timestamp": {
            "type": "integer",
            "format": "int64"
          },
          "sponsor": {
            "type": "string"
          }
        },
        "required": [
          "address",
          "email",
          "sponsor"
        ]
      },
      "RegisterResponse": {
        "type": "object",
        "properties": {
          "hash": {
            "type": "string"
          },
          "token": {
            "type": "string"
          }
        },
        "required": [
          "hash"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "CheckWalletResponse": {
        "type": "object",
        "properties": {
          "registered": {
            "type": "boolean"
          }
        },
        "required": [
          "registered"
        ]
      },
      "ListResponse": {
        "type": "object",
        "properties": {
          "users": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/User"
            }
          },
          "count": {
            "type": "integer",
            "format": "int32"
          }
        },
        "required": [
          "users",
          "count"
        ]
      },
      "Airdrop": {
        "type": "object",
        "description": "Unleak USDC (uUSDC) distribution state for an activated wallet. uUSDC is UnleakTrade's test version of USDC on Solana devnet — not real USDC, no real-world value.",
        "properties": {
          "cluster": {
            "type": "string",
            "example": "devnet"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "processing",
              "confirmed",
              "already_distributed",
              "failed_retryable",
              "failed_terminal"
            ]
          },
          "mint": {
            "type": "string",
            "example": "5jBqJmY2mKetudVa2XaC8U6UN2BNNirDiTnDEuA6pdyR"
          },
          "symbol": {
            "type": "string",
            "example": "uUSDC",
            "description": "Token symbol (Unleak USDC)"
          },
          "amount": {
            "type": "string",
            "example": "1000"
          },
          "rawAmount": {
            "type": "string",
            "example": "1000000000"
          },
          "signature": {
            "type": "string",
            "description": "Transaction signature, present once submitted; open it at https://explorer.solana.com/tx/{signature}?cluster=devnet"
          },
          "retryable": {
            "type": "boolean"
          }
        },
        "required": [
          "cluster",
          "status",
          "mint",
          "symbol",
          "amount",
          "rawAmount",
          "retryable"
        ]
      },
      "ActivationResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/User"
          },
          {
            "type": "object",
            "properties": {
              "activationStatus": {
                "type": "string",
                "example": "active"
              },
              "airdrop": {
                "$ref": "#/components/schemas/Airdrop"
              }
            },
            "required": [
              "activationStatus"
            ]
          }
        ]
      },
      "AirdropJob": {
        "type": "object",
        "description": "Stored distribution job (operator view).",
        "properties": {
          "address": {
            "type": "string"
          },
          "waitlist_uuid": {
            "type": "string"
          },
          "campaign": {
            "type": "string"
          },
          "cluster": {
            "type": "string"
          },
          "mint": {
            "type": "string"
          },
          "decimals": {
            "type": "integer"
          },
          "raw_amount": {
            "type": "integer"
          },
          "status": {
            "type": "string"
          },
          "attempts": {
            "type": "integer"
          },
          "signature": {
            "type": "string"
          },
          "created_at": {
            "type": "integer"
          },
          "started_at": {
            "type": "integer"
          },
          "confirmed_at": {
            "type": "integer"
          },
          "updated_at": {
            "type": "integer"
          },
          "next_attempt_at": {
            "type": "integer"
          },
          "lease_until": {
            "type": "integer"
          },
          "last_error_code": {
            "type": "string"
          },
          "last_error_msg": {
            "type": "string"
          }
        }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/check-wallet/{address}": {
      "get": {
        "summary": "Check wallet registration",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "address",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckWalletResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CheckWalletResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/{path1}/{path2}/list": {
      "get": {
        "summary": "List users",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "path1",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path2",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "max",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "mime",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "csv"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/register": {
      "post": {
        "summary": "Register user",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/User"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/activate/{token}/{hash}": {
      "post": {
        "summary": "Activate registration",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hash",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActivationResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/{path1}/{path2}/airdrop/list": {
      "get": {
        "summary": "List airdrop distribution jobs (operator reconciliation)",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "path1",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path2",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobs": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AirdropJob"
                      }
                    },
                    "count": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not found"
          },
          "503": {
            "description": "Distribution disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/{path1}/{path2}/airdrop/{address}/retry": {
      "post": {
        "summary": "Re-arm a failed airdrop job, or enqueue one for an activated address missing a job",
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "parameters": [
          {
            "name": "path1",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path2",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "address",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job re-armed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": {
                      "$ref": "#/components/schemas/AirdropJob"
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Job enqueued from scratch",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "airdrop": {
                      "$ref": "#/components/schemas/Airdrop"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "Address is not an activated waitlist member",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Job is not in a retryable state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Distribution disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}